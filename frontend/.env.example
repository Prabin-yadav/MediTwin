# ── MediTwin Frontend Environment (template) ─────────────────────────────────
# Copy to ".env" and fill in real values. Vite only exposes VITE_* variables.

# Google Cloud OAuth 2.0 Web Client ID (must match backend GOOGLE_CLIENT_ID).
# Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
