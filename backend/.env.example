# ── MediTwin Backend Environment (template) ──────────────────────────────────
# Copy to ".env" and fill in real values. NEVER commit the real .env.

# Database
MONGO_URI=mongodb://localhost:27017/meditwin_db

# Auth — generate a long random string for production
JWT_SECRET=change_me_to_a_long_random_secret

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Python executable used to run the ML engines (child_process).
#   Windows: py   |   macOS/Linux: python3
PYTHON_EXEC=py

# ── Admin Seed Credentials ───────────────────────────────────────────────────
# A single admin account is seeded on first boot using these values.
ADMIN_EMAIL=admin@meditwin.com
ADMIN_PASSWORD=change_me_strong_admin_password
ADMIN_NAME=System Administrator

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Google Cloud OAuth 2.0 Web Client ID. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# ── Optional: standalone FastAPI mode (not used by default child_process flow) ─
# MODULE1_API=http://localhost:8001
# MODULE2_API=http://localhost:8002
# MODULE3_API=http://localhost:8003
